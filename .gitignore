# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Data — never commit raw datasets
method/datasets/wadi/*.csv
method/datasets/wadi/*.xlsx
method/datasets/swat/SWaT.A1*/
method/datasets/swat/*.pdf
method/datasets/hvac/LBNL_FDD_Data_Sets_RTU/
method/datasets/rcaeval/RE1-OB/
method/datasets/rcaeval/RE1-SS/
method/datasets/rcaeval/RE1-TT/
method/datasets/rcaeval/RE2-*/
method/datasets/rcaeval/RE3-*/

# Fresh runner outputs (the `results_reference/` copy is the audit trail)
method/results/

# Per-dataset derived caches — regenerable from raw data; not committed
method/datasets/*/graph_cache_per_scenario/
method/datasets/*/llm_rca_cache_*/

_archive/

# Local symlinks to the raw datasets (a symlink is a file to git, so the
# directory patterns above do not match it)
method/datasets/swat/SWaT.A1*
method/datasets/hvac/LBNL_FDD_Data_Sets_RTU
method/datasets/rcaeval/RE1-*

# Backstop: never commit raw data files anywhere under the dataset loaders
method/datasets/**/*.csv
method/datasets/**/*.xlsx
method/datasets/**/*.xls
method/datasets/**/*.parquet
method/datasets/**/*.pkl
method/datasets/**/*.zip

# RCAEval checkout used by the BARO adapter on RCAEval (see README)
/RCAEval
